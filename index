<div id="dip-bucket-widget">
<div class="bucket-intro"><h1>Dip the Bucket!</h1><p>Pull some inspiration out of the Creative Well</p></div><section class="scene" id="scene" aria-label="Animated well with a bucket that lowers and rises"><div class="stars" aria-hidden="true"><span class="star" style="left:28%;top:34%;--delay:0s">✦</span><span class="star" style="left:63%;top:32%;--delay:.15s">✧</span><span class="star" style="left:44%;top:43%;--delay:.3s">✦</span><span class="star" style="left:71%;top:49%;--delay:.4s">✦</span><span class="star" style="left:33%;top:53%;--delay:.25s">✧</span><span class="star" style="left:54%;top:24%;--delay:.55s">✧</span><span class="star" style="left:19%;top:46%;--delay:.65s">✦</span></div><div class="well"><div class="well-back"></div><div class="water"></div><div class="well-front"></div></div><div class="rig"><div class="beam"></div><div class="rope"></div><div class="bucket"><div class="bucket-handle"></div><div class="bucket-body"></div></div></div></section><div class="controls"><button id="dip" type="button">Dip the Bucket!</button></div><section class="result" aria-live="polite" aria-atomic="true"><small>YOUR CREATIVE PROMPT</small><h2 id="prompt">What will you discover?</h2><p id="sub">Lower your bucket to discover a memory, feeling, or story to explore.</p></section><script>
(()=>{'use strict';const prompts=[{"title":"The First Thing You Remember","description":"Close your eyes and travel as far back as your memory allows. What room, face, sound, or color appears first? Describe the tiny details, even if the memory feels blurry.","source_prompt":185},{"title":"The Smell of Yesterday","description":"Think of a smell that instantly takes you somewhere else: rain on pavement, a favorite meal, sunscreen, or old books. Where does it take you, and who is there?","source_prompt":194},{"title":"The Place That Raised You","description":"Picture a street, room, yard, or neighborhood that feels woven into your story. What would someone hear and see if they stood there beside you? What does that place know about you?","source_prompt":135},{"title":"A Tiny Moment That Stayed","description":"Some memories last even though nothing huge happened. Remember an ordinary minute you still think about. What made it stick?","source_prompt":198},{"title":"The Thing You Almost Lost","description":"Remember something you misplaced, found, or feared you would never see again. Revisit the moment you realized it was gone—and what happened next.","source_prompt":190},{"title":"A Gift That Said Everything","description":"Think of a gift you gave or received that meant more than its price. Picture the hands, wrapping, room, and reaction. What did that gift really say?","source_prompt":192},{"title":"The Rules We Broke","description":"Remember a small childhood rule you broke—or wanted to break. Where were you standing? Who was with you? Capture the thrill, the nerves, and the aftermath.","source_prompt":187},{"title":"When the World Was Magic","description":"What did you believe was possible when you were younger? Revisit a place or moment when the ordinary world felt enchanted. What would your younger self tell you now?","source_prompt":189},{"title":"A Lucky Little Object","description":"Imagine holding an object you keep for luck, comfort, or sentimental reasons. How does it feel in your hand? Tell the story of how it became important.","source_prompt":195},{"title":"The Box of Keepsakes","description":"Picture a box filled with little pieces of your past: notes, tickets, photos, toys, or drawings. Choose one item and let it tell the story of a day you want to remember.","source_prompt":197},{"title":"The Kind of Love Nobody Sings About","description":"Love isn’t always about romance. Sometimes it’s your dog waiting at the door, a grandparent saving you the last cookie, or a friend who knows when something’s wrong. Think about someone or something you love in your own unusual way. What small, ordinary moment captures just how much they mean to you?"},{"title":"If You Could See Me Now","description":"Imagine meeting a younger version of yourself. Maybe they’re sitting in your old bedroom, playing with a favorite toy, or worrying about something that seems so small now. What would surprise them about who you’ve become? What would you want to tell them—and what might they remind you about yourself?"},{"title":"The Longest Five Minutes","description":"Remember a moment when time seemed to slow down: waiting for news, a ride, a result, or a friend. What were your eyes and hands doing while the clock crawled?","source_prompt":98},{"title":"The Ordinary Movie of My Life","description":"If a camera followed you on a completely normal day, which tiny moment would deserve a close-up? Describe the sounds, objects, and gestures that reveal something about you.","source_prompt":98},{"title":"My Quiet Place","description":"Where do you go—physically or in your imagination—when you need peace? Describe the light, sounds, and textures. What changes inside you when you arrive?","source_prompt":110},{"title":"The Ritual That Feels Like Home","description":"Think of a small routine that makes an ordinary day feel right. Maybe it involves breakfast, a walk, a greeting, or a favorite chair. What would you miss if it disappeared?","source_prompt":96},{"title":"The Dinner Table Scene","description":"Picture a meal you remember for more than the food. Who was there? What sounds filled the room? Tell the story through the dishes, voices, and little details.","source_prompt":521},{"title":"The Other Side of the Story","description":"Think of a moment when someone misunderstood you, or when you misunderstood someone else. Now replay that memory as if you’re watching the scene through their eyes. What might they have been thinking or feeling? What would you want them to understand about your side of the story?"},{"title":"The Voice I Carry","description":"Think of a phrase, joke, or piece of advice someone important says often. Hear their voice saying it. What does that voice remind you of, and when do you hear it in your mind?","source_prompt":152},{"title":"Someone Who Saw Me","description":"Remember a moment when someone noticed, encouraged, or believed in you. Where were you? What did they say or do? How did you feel afterward?","source_prompt":41},{"title":"A Thank-You I Haven’t Said","description":"Think of someone who has made an ordinary part of your life brighter. What small thing did they do? Imagine telling them what that moment meant to you.","source_prompt":182},{"title":"The Unexpected Hero","description":"Think of someone you admire who isn’t famous. Show us one moment that reveals why they’re special, using their actions and your memories instead of a list of compliments.","source_prompt":173},{"title":"The Family Story","description":"Recall a story about your family or the people who raised you. Maybe you’ve heard it many times. Picture the scene as if you were there, and notice what it says about where you come from.","source_prompt":148},{"title":"Our Strange Little Tradition","description":"Think of a tradition, saying, or inside joke shared with people close to you. What happens every time? Describe the details an outsider might never understand.","source_prompt":145},{"title":"A Friendship in One Scene","description":"Choose a single memory that captures what a friendship means to you. Maybe it’s a laugh, a walk, a game, or a quiet conversation. What happened that day?","source_prompt":437},{"title":"The Friend I Didn’t Expect","description":"Think of someone you connected with even though you seemed different at first. Remember the moment you began to understand each other. What changed?","source_prompt":436},{"title":"When the Group Changed","description":"Friendships sometimes shift as we grow. Recall a moment when a familiar group, routine, or connection felt different. What did you notice, and what did you wish you could say?","source_prompt":445},{"title":"The Seat Beside Me","description":"Remember a time you felt included—or wished someone would make room for you. Picture the chairs, faces, and sounds around you. What did that moment feel like?","source_prompt":440},{"title":"The Conversation I Replay","description":"Think of a conversation that stayed with you, whether funny, awkward, surprising, or kind. Where did it happen? What words, pauses, or expressions do you remember?","source_prompt":449},{"title":"The Smallest Act of Kindness","description":"Remember a kindness you witnessed, received, or offered. It might have lasted only a few seconds. Describe the moment as if it were the most important scene in a movie.","source_prompt":222},{"title":"The Brave Little Yes","description":"Remember a time you tried something that made you nervous. What did the world look and sound like just before you began? What happened when you took the first step?","source_prompt":2},{"title":"The Day I Tried Again","description":"Think of something that didn’t work out the first time. Revisit the moment you decided to try again. What had changed inside you?","source_prompt":16},{"title":"A Different Kind of Victory","description":"Remember a small accomplishment that meant a lot to you, even if nobody else noticed. What did you do? What did that private victory feel like?","source_prompt":32},{"title":"The Day I Started Over","description":"Think of a fresh start: a new school year, team, hobby, home, or friendship. What did you leave behind, and what did you hope to find?","source_prompt":25},{"title":"The Version of Me I Used to Be","description":"Imagine sitting beside a younger version of yourself in a place you remember from childhood. Look around. What toys, posters, sounds, or familiar objects surround you? What did you dream about or worry about back then? What would you want to tell your younger self today—and what might they remind you about who you really are?"},{"title":"My Favorite Holiday","description":"Think of your favorite holiday. What is it, and what makes it so special to you? Transport yourself back to a particular celebration. Picture the decorations, the colors, the people, the sounds, the food, and the way the light fills the room or sky. What tiny details make this day feel magical? What is it about this holiday that you wish you could bottle up and keep forever?"},{"title":"What They Don’t See","description":"Think of something about you that people might overlook: a hobby, worry, talent, or dream. What everyday scene could show that hidden part of you?","source_prompt":201},{"title":"The Thing I’m Learning to Love","description":"Think of an interest or part of yourself you once felt shy about sharing. When did it begin to matter to you? Describe a moment when you felt free to enjoy it.","source_prompt":91},{"title":"The Dream I Haven’t Told Everyone","description":"Imagine a future version of yourself doing something you care about. What does the scene look and sound like? What would you want that future self to remember about today?","source_prompt":80},{"title":"One Thing I Wish I Could Say","description":"Think of words you’ve wanted to say to someone: thank you, I’m sorry, I miss you, or I’m proud of you. You don’t have to name the person. Describe the moment around those unsaid words.","source_prompt":360},{"title":"The Apology Scene","description":"Remember a small misunderstanding or mistake, real or imagined. What was said, and what was left unsaid? Explore how the scene might change if someone spoke from the heart.","source_prompt":223},{"title":"A Place I Belong","description":"Picture a moment when you felt completely comfortable being yourself. Who or what made that possible? Describe the room, the sounds, and the feeling of belonging.","source_prompt":24},{"title":"The Moment I Felt Alive","description":"Think of an activity that makes you forget the clock. Take us into one specific moment: the movement, noise, excitement, and feeling of being completely there.","source_prompt":78},{"title":"The Sound of My Hometown","description":"Imagine recording the sounds of the place you call home. Which voices, footsteps, traffic, birds, or doors would you capture? What memories live inside those sounds?","source_prompt":121},{"title":"The View From My Window","description":"Choose a window you know well. What can you see from it at different times of day? Describe a moment when the view seemed to match how you felt.","source_prompt":140},{"title":"The Photograph I Keep","description":"Think of a photograph you remember clearly. Who is in it? What happened just before or after the picture was taken? Tell the story beyond the frame.","source_prompt":369},{"title":"The Weather That Remembers","description":"Recall a day when the weather felt unforgettable: heavy rain, a windy afternoon, first snow, or blazing sun. What happened under that sky?","source_prompt":566},{"title":"The Animal Who Taught Me Something","description":"Think of an animal you’ve known or watched closely. Recall a funny, tender, or surprising moment. What did it reveal about patience, trust, or yourself?","source_prompt":562},{"title":"The Trip I Still Carry","description":"Return to a journey, even a short one, that you remember vividly. What did you see through the window? What changed between leaving and coming home?","source_prompt":498},{"title":"The Last Day of Something","description":"Think of the final day of a season, class, trip, or tradition. What tiny detail told you it was ending? What did you want to hold onto a little longer?","source_prompt":547}];const root=document.getElementById('dip-bucket-widget');if(!root)return;const button=root.querySelector('#dip'),scene=root.querySelector('#scene'),title=root.querySelector('#prompt'),sub=root.querySelector('#sub');let last=-1;const delay=ms=>new Promise(r=>setTimeout(r,ms));function pick(){let n;const a=new Uint32Array(1);do{if(window.crypto&&crypto.getRandomValues){crypto.getRandomValues(a);n=a[0]%prompts.length}else{n=Math.floor(Math.random()*prompts.length)}}while(n===last&&prompts.length>1);last=n;return prompts[n]}button.addEventListener('click',async()=>{button.disabled=true;button.textContent='Dipping…';scene.className='scene lowering';title.textContent='Searching for inspiration…';sub.textContent='';await delay(1900);scene.className='scene submerged';await delay(650);scene.className='scene raising';await delay(1900);scene.className='scene reveal';const chosen=pick();title.textContent=chosen.title;sub.textContent=chosen.description;button.disabled=false;button.textContent='Dip Again';});})();
</script>
</div>
